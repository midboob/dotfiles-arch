# : Manager [[[

[manager]
cwd = { fg = "#e1e4da" }

# Tab
tab_active = { fg = "#11380b", bg = "#a5d395", bold = true }
tab_inactive = { fg = "#c1efaf", bg = "#012200" }
tab_width = 1

# Find
find_keyword = { fg = "#ffb4ab", bold = true, italic = true, underline = true }
find_position = { fg = "#ffb4ab", bold = true, italic = true }

# Marker
marker_copied = { fg = "#6bd3d9", bg = "#6bd3d9" }
marker_cut = { fg = "#bcebee", bg = "#bcebee" }
marker_marked = { fg = "#ffb4ab", bg = "#ffb4ab" }
marker_selected = { fg = "#a0cfd2", bg = "#a0cfd2" }

# Count
count_copied = { fg = "#002021", bg = "#bcebee" }
count_cut = { fg = "#002021", bg = "#bcebee" }
count_selected = { fg = "#11380b", bg = "#a0cfd2" }

# Border
border_symbol = "│"
border_style  = { fg = "#a5d395" }

# : ]]]


# : Status [[[

[status]
separator_open = "🭁"
separator_close = "🭠"
separator_style = { bg = "#11380b", fg = "#F4A261" }

[mode]
# Mode
normal_main = { bg = "#a5d395", fg = "#11380b", bold = true }
normal_alt  = { bg = "#43483f", fg = "#c3c8bc" }

# Select mode
select_main = { bg = "#bbcbb1", fg = "#263422", bold = true }
select_alt  = { bg = "#43483f", fg = "#c3c8bc" }

# Unset mode
unset_main = { bg = "#a0cfd2", fg = "#003739", bold = true }
unset_alt  = { bg = "#43483f", fg = "#c3c8bc" }

# Progress
progress_label = { bold = true }
progress_normal = { fg = "#a5d395", bg = "#363a34" }
progress_error = { fg = "#ffb4ab", bg = "#363a34" }

# Permissions
permissions_t = { fg = "#6c885b" }
permissions_w = { fg = "#468f93" }
permissions_x = { fg = "#ff2b12" }
permissions_r = { fg = "#42c7cf" }
permissions_s = { fg = "#5ed530" }

# : ]]]


# : Select [[[

[select]
border = { fg = "#a5d395" }
active = { fg = "#a0cfd2", bold = true }
inactive = {}

# : ]]]


# : Input [[[

[input]
border = { fg = "#a5d395" }
value = { fg = "#e1e4da" }

# : ]]]


# : Completion [[[

[completion]
border = { fg = "#a5d395", bg = "#11380b" }

# : ]]]


# : Tasks [[[

[tasks]
border = { fg = "#a5d395" }
title = {}
hovered = { fg = "#bcebee", underline = true }

# : ]]]


# : Which [[[

[which]
cols = 3
mask = { bg = "#363a34" }
cand = { fg = "#a5d395" }
rest = { fg = "#11380b" }
desc = { fg = "#e1e4da" }
separator = " ▶ "
separator_style = { fg = "#e1e4da" }

# : ]]]


# : Help [[[

[help]
on = { fg = "#e1e4da" }
run = { fg = "#e1e4da" }
footer = { fg = "#263422", bg = "#bbcbb1" }

# : ]]]


# : Notify [[[

[notify]
title_info = { fg = "#a0cfd2" }
title_warn = { fg = "#a5d395" }
title_error = { fg = "#ffb4ab" }

# : ]]]


# : File-specific styles [[[

[filetype]

rules = [
    # Images
    { mime = "image/*", fg = "#94e2d5" },

    # Media
    { mime = "{audio,video}/*", fg = "#f9e2af" },

    # Archives
    { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#f5c2e7" },

    # Documents
    { mime = "application/{pdf,doc,rtf}", fg = "#a6e3a1" },

    # Special files
    { name = "*", is = "orphan", bg = "#93000a" },
    { name = "*", is = "exec", fg = "#ffdad6" },

    # Fallback
    { name = "*", fg = "#e1e4da" },
    { name = "*/", fg = "#a5d395" },
]

# : ]]]